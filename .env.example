# Render can run the repository root scripts. Put server secrets in backend/.env locally
# or configure these values in the deployment dashboard.
NODE_ENV=production
MONGO_URL=mongodb+srv://username:password@cluster.example.mongodb.net/streamify
MONGO_MAX_POOL_SIZE=10
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_ORIGINS=https://your-frontend.example.com
COOKIE_SAME_SITE=lax
COOKIE_SECURE=true
STREAM_API_KEY=replace-with-stream-api-key
STREAM_API_SECRET=replace-with-stream-api-secret
STREAM_CALL_TYPE=default
