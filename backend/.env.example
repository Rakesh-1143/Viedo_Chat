NODE_ENV=development
PORT=5001

# Local MongoDB example: mongodb://127.0.0.1:27017/streamify
MONGO_URL=mongodb://127.0.0.1:27017/streamify
MONGO_MAX_POOL_SIZE=10

# Use a long random value with at least 32 characters.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Comma-separated list. Add the exact deployed frontend URL in production.
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Keep lax when frontend and API share a site. Use none only for truly cross-site HTTPS deployments.
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

STREAM_API_KEY=replace-with-stream-api-key
STREAM_API_SECRET=replace-with-stream-api-secret
STREAM_CALL_TYPE=default

# Optional. Sends a welcome email on signup via Gmail SMTP. Leave unset to
# disable. EMAIL_APP_PASSWORD must be a Gmail "App Password" (requires
# 2-Step Verification), not your regular account password:
# https://myaccount.google.com/apppasswords
EMAIL_USER=
EMAIL_APP_PASSWORD=

# Optional. Comma-separated admin emails auto-promoted to the admin role.
ADMIN_EMAILS=

# Optional. Enables real background push notifications. Generate with:
# node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=mailto:admin@example.com
